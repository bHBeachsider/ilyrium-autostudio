#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @./cameras.usda@
    ]
    upAxis = "Z"
)

def Xform "World" (
    kind = "assembly"
    variants = {
        string build = "half_decked"
        string weather = "overcast_drizzle"
    }
    prepend variantSets = ["build", "weather"]
)
{
    custom string backlot:origin = "centre of City Hall's portico semicircle at pavement level; +X along the facade to the right, +Y into the square, +Z up"
    custom string backlot:production = "NEW HARNOMY, U.S.A."

    def Xform "AxisStreet" (
        prepend references = @./assets/AxisStreet/AxisStreet.usda@
    )
    {
    }

    def Xform "Banner" (
        prepend references = @./assets/Banner/Banner.usda@
    )
    {
    }

    def Xform "BlackChurch" (
        prepend references = @./assets/BlackChurch/BlackChurch.usda@
    )
    {
    }

    def Xform "Bodega" (
        prepend references = @./assets/Bodega/Bodega.usda@
    )
    {
    }

    def Xform "BuildSite" (
        prepend references = @./assets/BuildSite/BuildSite.usda@
    )
    {
    }

    def Xform "CityHall" (
        prepend references = @./assets/CityHall/CityHall.usda@
    )
    {
    }

    def Xform "EastBlocks" (
        prepend references = @./assets/EastBlocks/EastBlocks.usda@
    )
    {
    }

    def Xform "Ground" (
        prepend references = @./assets/Ground/Ground.usda@
    )
    {
    }

    def Xform "NorthRow" (
        prepend references = @./assets/NorthRow/NorthRow.usda@
    )
    {
    }

    def Xform "PILFOffice" (
        prepend references = @./assets/PILFOffice/PILFOffice.usda@
    )
    {
    }

    def Xform "ParishChurch" (
        prepend references = @./assets/ParishChurch/ParishChurch.usda@
    )
    {
    }

    def Xform "RallyStage" (
        prepend references = @./assets/RallyStage/RallyStage.usda@
    )
    {
    }

    def Xform "Restaurant" (
        prepend references = @./assets/Restaurant/Restaurant.usda@
    )
    {
    }

    def Xform "Square" (
        prepend references = @./assets/Square/Square.usda@
    )
    {
    }

    def Xform "University" (
        prepend references = @./assets/University/University.usda@
    )
    {
    }

    def Xform "Vehicles" (
        prepend references = @./assets/Vehicles/Vehicles.usda@
    )
    {
    }

    def Xform "WestShops" (
        prepend references = @./assets/WestShops/WestShops.usda@
    )
    {
    }
    variantSet "build" = {
        "beam_seated" {
            over "RallyStage" (
                active = true
                variants = {
                    string build = "beam_seated"
                }
            )
            {
            }

            over "BuildSite" (
                active = true
                variants = {
                    string build = "beam_seated"
                }
            )
            {
            }

        }
        "feast" {
            over "RallyStage" (
                active = true
                variants = {
                    string build = "feast"
                }
            )
            {
            }

            over "BuildSite" (
                active = false
            )
            {
            }

        }
        "finished" {
            over "RallyStage" (
                active = true
                variants = {
                    string build = "finished"
                }
            )
            {
            }

            over "BuildSite" (
                active = false
            )
            {
            }

        }
        "half_decked" {
            over "RallyStage" (
                active = true
                variants = {
                    string build = "half_decked"
                }
            )
            {
            }

            over "BuildSite" (
                active = true
                variants = {
                    string build = "half_decked"
                }
            )
            {
            }

        }
        "joists" {
            over "RallyStage" (
                active = true
                variants = {
                    string build = "joists"
                }
            )
            {
            }

            over "BuildSite" (
                active = true
                variants = {
                    string build = "joists"
                }
            )
            {
            }

        }
        "swept" {
            over "RallyStage" (
                active = true
                variants = {
                    string build = "swept"
                }
            )
            {
            }

            over "BuildSite" (
                active = true
                variants = {
                    string build = "swept"
                }
            )
            {
            }

        }
    }
    variantSet "weather" = {
        "dusk" {
            custom token backlot:weather = "dusk"

        }
        "first_light" {
            custom token backlot:weather = "first_light"

        }
        "overcast_drizzle" {
            custom token backlot:weather = "overcast_drizzle"

        }
    }
}

