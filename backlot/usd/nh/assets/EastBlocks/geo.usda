{
    def Xform "east_block_2"
    {
        custom string userProperties:backlot_asset = "EastBlocks"
        custom string userProperties:backlot_state = "*"
        custom string userProperties:blender:object_name = "east_block_2"
        float3 xformOp:rotateXYZ = (0, -0, 0)
        float3 xformOp:scale = (22, 16, 16)
        double3 xformOp:translate = (62, 88, 8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        def Mesh "east_block_2" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
