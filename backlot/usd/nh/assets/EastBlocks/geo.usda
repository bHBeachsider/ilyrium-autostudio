            uniform token subdivisionScheme = "none"
            custom string userProperties:blender:data_name = "east_block_2"
        }
    }

    def Scope "_materials"
    {
        def Material "brick_pale"
        {
            token outputs:surface.connect = </geo/_materials/brick_pale/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "brick_pale"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.66, 0.5, 0.42)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.9
                float inputs:specular = 0.5
                token outputs:surface
            }
        }
    }

