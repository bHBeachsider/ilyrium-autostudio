# Ilyrium AutoStudio — environment variables
# Copy to .env and fill in your values. Never commit .env.

# ── Core LLM ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_API=
XAI_API_KEY=
XAI_GATEWAY_API=
HUGGING_FACE_API_KEY=

# ── Local LLM ─────────────────────────────────────────────────────────────────
LOCAL_LLM_MODEL=
OLLAMA_KEEP_VRAM=

# ── Edit engine ───────────────────────────────────────────────────────────────
# Set ILYRIUM_EDIT_ENGINE=filmcraft to use FilmCraft; leave unset (or set to
# moviepy) to keep the default moviepy path (see producer.assemble_cut).
ILYRIUM_EDIT_ENGINE=

# Absolute path to filmcraft-cli.exe (built from the filmcraft/ subdir).
# FILMCRAFT_CLI=C:\path\to\ilyrium-autostudio\filmcraft\target\release\filmcraft-cli.exe
FILMCRAFT_CLI=

# Git commit of the pinned FilmCraft clone (filmcraft/ is gitignored).
# Verified: 0541d4d (0.7.0, 2026-10-12). Phase 0 bake-off results in
# docs/research/2026-10-12-filmcraft-bakeoff-results.md.
FILMCRAFT_PIN=0541d4d

# ── Media generation APIs ─────────────────────────────────────────────────────
FAL_KEY=
RUNWAYML_API_SECRET=
APIFRAME_API_KEY=
ASTRIA_API_KEY=
CIVITAI_API_KEY=
TENSORART_API_TOKEN=
ELEVENLABS_API_KEY=
ELEVEN_LABS_API_2=

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_HOST=

# ── Database ──────────────────────────────────────────────────────────────────
NEON_DATABASE_URL=

# ── Studio MCP / pipeline service ────────────────────────────────────────────
SITE_BOX_BASE_URL=http://127.0.0.1:8800
SITE_BOX_INGEST_SECRET=

# ── Google / mapping ─────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
GOOGLE_CUSTOM_SEARCH_API=
GOOGLE_CSE_CX=
GOOGLE_TILES=
EE_SERVICE_ACCOUNT=

# ── Data / research APIs ──────────────────────────────────────────────────────
CENSUS_DATA_API_KEY=
HARVARD_API_KEY=
SMITHSONIAN_API_KEY=
GEO_GEOCODER_PROVIDER=
SERPER_API_KEY=

# ── Social / distribution ─────────────────────────────────────────────────────
TRANSISTOR_API_KEY=
X_BEARER_TOKEN=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────────────
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=
