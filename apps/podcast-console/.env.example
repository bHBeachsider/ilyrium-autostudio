# apps/podcast-console — environment template.
# Copy to .env.local (gitignored) and fill in. Restart `pnpm dev` after changes.

# --- Voices: ElevenLabs (/api/synthesize) ---------------------------------
# Required for voice synthesis. Create at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional. Voice ids from your ElevenLabs voice library (Voices -> ... -> Copy Voice ID).
# Defaults: Rachel (US) for Host A, George (UK) for Host B.
ELEVENLABS_VOICE_A=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_B=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Script + scene images: Vercel AI Gateway (/api/generate-episode, /api/generate-images) ---
# Routes OpenAI (gpt-5-mini) + Google Imagen with one key. Works off-Vercel.
# Create at https://vercel.com/dashboard -> AI Gateway -> API keys
AI_GATEWAY_API_KEY=

# --- Research + verification (production pipeline) + /api/ingest -----------
# REQUIRED for producing episodes: the research step retrieves real sources via
# Perplexity's Search API and the fact-check gate judges every claim against them.
PERPLEXITY_API_KEY=
# Optional: override the citable-domain allowlist (comma-separated, max 20).
RESEARCH_TRUSTED_DOMAINS=
# Optional: raises Jina Reader (full-article extraction) rate limits.
JINA_API_KEY=

# --- Access control ---------------------------------------------------------
# Login password for the whole studio (pages + API). REQUIRED in production:
# without it the deployment fails closed (503). Unset = open in local dev.
STUDIO_PASSWORD=

# --- Persistence: Neon Postgres -------------------------------------------
# Enables the episode archive, ideas queue and studio tables. Without it the
# app still runs; DB routes return 503 {dbUnconfigured:true}.
DATABASE_URL=

# --- Durable media storage: Cloudflare R2 (same bucket as apps/auto-studio) ---
# Imported/produced audio+video are copied here and served via R2_PUBLIC_HOST.
# Without R2 the importer stores remote source URLs where available.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ilyrium-assets
# Browser-public custom domain mapped to the bucket, e.g. https://media.example.com
R2_PUBLIC_HOST=

# --- Episode ingest sources (/api/episodes/import) — all optional ---------
# A. Local producer output: the PermitHub-API data/podcasts directory
#    (week folders with episode.mp3 + script.json + manifest.json).
PBC_PODCAST_DIR=
# B. PermitHub admin API. The token is a JWT accepted by its withAuth middleware.
PERMITHUB_BASE_URL=
PERMITHUB_ADMIN_TOKEN=
# C. Podcast RSS feed (e.g. the Transistor show feed).
PODCAST_RSS_URL=

# --- Approval workflow ------------------------------------------------------
# true = two-gate review (approve idea, then approve its drafted script).
# Default/unset = one gate: idea approval alone unlocks production.
STUDIO_TWO_GATE=

# --- Telegram HITL mirror (optional) ---------------------------------------
# Mirrors new proposals to a chat with inline approve/reject. The in-app queue
# stays authoritative. Register the webhook with your deployed URL:
#   https://api.telegram.org/bot<token>/setWebhook?url=<app>/api/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Distribution channels (each independently opt-in) ---------------------
# Transistor.fm (makes the RSS feed live for Apple/Spotify + site-box)
PUBLISH_TRANSISTOR_ENABLED=
TRANSISTOR_API_KEY=
TRANSISTOR_SHOW_ID=
# SAFETY: episodes are created as DRAFTS unless this is 'true'.
TRANSISTOR_PUBLISH=
# site-box website (RSS-based: verifies the Transistor chain, reports feed URL)
PUBLISH_SITEBOX_ENABLED=
# YouTube (manual-export package: MP4 URL + drafted metadata; OAuth later)
PUBLISH_YOUTUBE_ENABLED=
# Social clips (ffmpeg highlights + drafted post copy on R2)
PUBLISH_CLIPS_ENABLED=

# --- Continuous idea loop (Phase 5) ----------------------------------------
# KILL SWITCH: the loop only runs when this is exactly 'true'. Default OFF.
STUDIO_LOOP_ENABLED=
# Bearer token required by /api/loop/tick when set (use as CRON_SECRET on Vercel).
LOOP_SECRET=
# Per-tick budget caps.
LOOP_MAX_IDEAS_PER_RUN=5
LOOP_MAX_ITEMS_SCANNED=50
