{
  "version": "1.0",
  "note": "Curated, capability-tagged catalog of generation models/engines the agent chooses from. TAMS has no list-all-models API, so this is hand-grown: add an entry per model you've vetted (the id is the TensorArt model id, or the engine name for non-TensorArt providers). The selector (model_select.py) scores these against a project's style_kernel.json. ComfyUI convention: adding an on-box model = ONE provider='comfyui' entry with id 'comfyui:<short-id>' plus either a 'recipe' block (unet/clip/clip_type/vae/latent/steps/cfg/sampler/scheduler[/weight_dtype/hint] -> programmatic graph, supports txt2img/img2img/inpaint/region) or a 'workflow' path (pre-exported comfyui_workflows/*_api.json template with __PROMPT__/__SEED__ tokens, txt2img only). media/comfyui_engine.py reads these; the pipeline runs them via model='comfyui:<short-id>'. Abliterated/uncensored models are just another entry pointing at their safetensors.",
  "modalities": {
    "txt2img": "text -> still image",
    "img2img": "image -> image (restyle/upscale)",
    "keyframe": "still meant to seed a video shot",
    "t2v": "text -> video",
    "i2v": "image -> video (first frame drives motion)",
    "v2v": "video -> video (edit/relight/restyle)",
    "3d": "3D / virtual-production render"
  },
