// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  status      String   @default("DRAFT") // DRAFT, RENDERING, ASSEMBLING, COMPLETED, FAILED
  createdAt   DateTime @default(now())
  
  scenes      Scene[]
}

model Scene {
  id              String   @id @default(cuid())
  campaignId      String
  sceneNumber     Int
  
  // The manifest data
  visualPrompt    String   @db.Text
  cleanVoiceover  String   @db.Text
  
  // Audio State (Usually fast, seconds)
  audioStatus     String   @default("PENDING") // PENDING, DONE, FAILED
  audioUrl        String?  // Storage link once finished
  
  // Video State (Usually slow, minutes)
  videoStatus     String   @default("PENDING") // PENDING, PROCESSING, DONE, FAILED
  videoProviderId String?  // The Job ID returned by Runway/Luma to check later
  videoUrl        String?  // The final mp4 link

  campaign        Campaign @relation(fields: [campaignId], references: [id])
}