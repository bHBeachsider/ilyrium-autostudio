venv/
outputs/
# Rendered images pulled from the box (keep the folder, ignore its contents)
apps/auto-studio/cli/renders/*
!apps/auto-studio/cli/renders/.gitkeep
# Broderick LoRA weights (canonical in S3)
projects/broderick/_training/local_artifacts/loras/
# Secrets / local env — never commit
.env
.env.local
.env.*.local
.env.bak-*

# Private keys — never commit
*.pem

# SQLite dev databases (takes layer)
apps/control-panel/takes-dev.db
apps/control-panel/takes-dev.db-journal

# Ledger runtime files (keep the .gitkeep, ignore actual .jsonl files produced in dev)
ilyrium-shots/ledger/*.jsonl

# Python cache
__pycache__/
*.pyc
